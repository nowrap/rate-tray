<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RateTray</AssemblyName>
    <RootNamespace>RateTray</RootNamespace>
    <Version>0.2.0</Version>
    <Product>RateTray</Product>
    <Company>nowrap</Company>
    <Authors>nowrap</Authors>
    <Copyright>Copyright (c) 2026 nowrap</Copyright>
    <Description>Live usage limits for Claude Code and Codex, in the Windows tray.</Description>

    <!-- Generated by tools/New-AppIcon.ps1 — edit that script, not the .ico. -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Tray icons are rendered per-monitor; without this they blur on scaled displays. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!-- Only applied by `dotnet publish -r win-x64`; a plain build stays framework-dependent. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Globbed on purpose: dropping in Localization/xx.json adds a language with no csproj edit. -->
    <EmbeddedResource Include="Localization\*.json" />

    <!-- Also embedded, not just set as the exe icon: a single-file publish has no app.ico on
         disk for windows to load at runtime. -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RateTray.Tests" />
  </ItemGroup>

</Project>
